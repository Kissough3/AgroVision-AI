{
  "name": "AgroVision AI Development",
  "build": {
    "dockerfile": "Dockerfile.codespaces"
  },
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "20",
      "installYarnUsingApt": false
    },
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {}
  },
  "forwardPorts": [3000, 8000, 8080, 9000, 9001],
  "portsAttributes": {
    "3000": { "label": "Next.js" },
    "8000": { "label": "FastAPI" },
    "8080": { "label": "TiTiler" },
    "9000": { "label": "MinIO" },
    "9001": { "label": "MinIO Console" }
  },
  "customizations": {
    "vscode": {
      "settings": { "python.defaultInterpreterPath": "/usr/local/bin/python" }
    }
  },
  "remoteUser": "vscode"
}
